{
  "version": 1,
  "cluster_id": "prepared-gcp",
  "provider": "gcp",
  "account_id": "example-project",
  "region": "asia-northeast3",
  "members": [
    {
      "id": "control",
      "role": "control_plane",
      "availability_zone": "asia-northeast3-a",
      "ssh": {
        "user": "ubuntu",
        "port": 22,
        "identity_file": "/etc/railshot/operator/id_ed25519",
        "known_hosts_file": "/etc/railshot/operator/known_hosts"
      },
      "descriptor_file": "/etc/railshot/operator/control-descriptor.json"
    },
    {
      "id": "compute-a",
      "role": "workers",
      "availability_zone": "asia-northeast3-b",
      "ssh": {
        "user": "ubuntu",
        "port": 22,
        "identity_file": "/etc/railshot/operator/id_ed25519",
        "known_hosts_file": "/etc/railshot/operator/known_hosts"
      },
      "descriptor_file": "/etc/railshot/operator/compute-a-descriptor.json"
    },
    {
      "id": "compute-b",
      "role": "workers",
      "availability_zone": "asia-northeast3-c",
      "ssh": {
        "user": "ubuntu",
        "port": 22,
        "identity_file": "/etc/railshot/operator/id_ed25519",
        "known_hosts_file": "/etc/railshot/operator/known_hosts"
      },
      "descriptor_file": "/etc/railshot/operator/compute-b-descriptor.json"
    }
  ],
  "runtime": {
    "wait_timeout_seconds": 300,
    "storage": {
      "backend": "filestore",
      "mode": "reuse",
      "binding": {
        "cluster_id": "prepared-gcp",
        "provider": "gcp",
        "account_id": "example-project",
        "region": "asia-northeast3"
      }
    },
    "edge": "/etc/railshot/operator/gcp-edge.json"
  }
}
