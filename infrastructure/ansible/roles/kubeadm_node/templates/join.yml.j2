apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration
discovery:
  bootstrapToken:
    token: {{ hostvars[groups.kubeadm_control[0]].railshot_join_token }}
    apiServerEndpoint: "{{ railshot_api_address }}:6443"
    caCertHashes:
      - "sha256:{{ hostvars[groups.kubeadm_control[0]].railshot_ca_hash.stdout }}"
nodeRegistration:
  name: {{ inventory_hostname }}
  criSocket: unix:///run/containerd/containerd.sock
  kubeletExtraArgs:
    - name: node-ip
      value: {{ railshot_node_ip }}
