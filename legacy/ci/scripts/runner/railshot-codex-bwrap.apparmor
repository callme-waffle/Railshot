# Derived from containerd's Apache-2.0 default profile.
# The Docker Authors; The Moby Authors; The containerd Authors.
#include <tunables/global>
profile railshot-codex-bwrap flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  deny network alg,
  deny network vsock,
  capability,
  file,
  userns,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=railshot-codex-bwrap,
  ptrace (trace,tracedby,read,readby) peer=railshot-codex-bwrap,
  # bwrap has no host SYS_ADMIN: these mounts can only succeed in its new user namespace.
  mount -> /{,tmp/,tmp/**,newroot/,newroot/**,oldroot/,oldroot/**},
  pivot_root,
  umount /{,tmp/,tmp/**,newroot/,newroot/**,oldroot/,oldroot/**},
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
}
