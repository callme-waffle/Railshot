{
  "title": "Patroni overview",
  "uid": "jasmin-patroni",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": [
    "patroni"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Primary count",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (scope) (patroni_primary)",
          "legendFormat": "{{scope}} {{name}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "PostgreSQL running",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "patroni_postgres_running",
          "legendFormat": "{{scope}} {{name}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Streaming replicas",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "patroni_postgres_streaming",
          "legendFormat": "{{scope}} {{name}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Synchronous standby",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "patroni_sync_standby",
          "legendFormat": "{{scope}} {{name}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "DCS contact age (seconds)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - patroni_dcs_last_seen",
          "legendFormat": "{{scope}} {{name}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Pending restart",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "patroni_pending_restart",
          "legendFormat": "{{scope}} {{name}}"
        }
      ]
    }
  ]
}
