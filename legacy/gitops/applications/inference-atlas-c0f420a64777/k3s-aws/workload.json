{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "inference-atlas",
        "namespace": "tenant-jihwan-atlas"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "inference-atlas",
            "railshot.io/target": "k3s-aws"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "inference-atlas",
              "railshot.io/target": "k3s-aws"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "nodeSelector": {
              "kubernetes.io/arch": "amd64"
            },
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 65532,
              "runAsGroup": 65532,
              "fsGroup": 65532,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "web",
                "image": "ghcr.io/jasmin-softbank/jihwan-inference-atlas-web@sha256:81c63de649c6862c4477af9ce0201f9492cecf435062f82095026aac5d54abba",
                "ports": [
                  {
                    "containerPort": 8080
                  }
                ],
                "env": [
                  {
                    "name": "PORT",
                    "value": "8080"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "256Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/health",
                    "port": 8080
                  },
                  "periodSeconds": 5
                }
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "64Mi"
                }
              }
            ],
            "imagePullSecrets": [
              {
                "name": "ghcr-pull"
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "inference-atlas",
        "namespace": "tenant-jihwan-atlas"
      },
      "spec": {
        "type": "NodePort",
        "selector": {
          "app.kubernetes.io/name": "inference-atlas",
          "railshot.io/target": "k3s-aws"
        },
        "externalTrafficPolicy": "Local",
        "ports": [
          {
            "port": 8080,
            "targetPort": 8080,
            "nodePort": 30081
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "inference-atlas",
        "namespace": "tenant-jihwan-atlas"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/name": "inference-atlas",
            "railshot.io/target": "k3s-aws"
          }
        },
        "policyTypes": [
          "Ingress",
          "Egress"
        ],
        "egress": [],
        "ingress": [
          {
            "from": [
              {
                "ipBlock": {
                  "cidr": "172.31.0.0/20"
                }
              },
              {
                "ipBlock": {
                  "cidr": "172.31.16.0/20"
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 8080
              }
            ]
          }
        ]
      }
    }
  ]
}
