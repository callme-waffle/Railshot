[Unit]
Description=Patroni PostgreSQL cluster manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=postgres
Group=postgres
ExecStart=/opt/patroni/bin/patroni /etc/patroni/patroni.yml
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
TimeoutStopSec=120
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
