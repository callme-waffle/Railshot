# Copy outside Git; pass with docker compose --env-file /private/railshot.env.
RAILSHOT_API_TOKEN_PATH=/absolute/private/path/railshot-api-token
# No GitHub credential is needed for container health/MCP protocol smoke.
# Real publication requires a dedicated credential and an operator-approved target.
GITHUB_TOKEN=
GITHUB_OWNER=Jasmin-Softbank
GITHUB_REPO=railshot-apps
GITHUB_REF=main
GITHUB_WORKFLOW=railshot-deploy.yml
RAILSHOT_TENANT=demo
RAILSHOT_TARGET_ID=
