{
  "schema_version": "0.1",
  "provider": "gcp",
  "environment_id": "railshot-runtime-demo",
  "node": {
    "host": "localhost",
    "ssh_user": "ubuntu"
  },
  "workload": {
    "image": "nginx:1.28.0-alpine",
    "namespace": "railshot-demo",
    "replicas": 1,
    "container_port": 80,
    "health_path": "/",
    "sample_content": true
  },
  "exposure": {
    "type": "nodeport",
    "node_port": 30080
  },
  "runtime": {
    "timeout_seconds": 180
  }
}
