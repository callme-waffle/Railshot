{
  "apiVersion": "apps/v1", "kind": "Deployment",
  "metadata": {"name": "$name", "namespace": "$namespace"},
  "spec": {
    "replicas": "$replicas", "minReadySeconds": 3, "progressDeadlineSeconds": 120,
    "strategy": {"type": "RollingUpdate", "rollingUpdate": {"maxUnavailable": 0, "maxSurge": 1}},
    "selector": {"matchLabels": {"railshot.io/app": "$name"}},
    "template": {
      "metadata": {"labels": {"railshot.io/app": "$name"}},
      "spec": {
        "automountServiceAccountToken": false, "terminationGracePeriodSeconds": 15,
        "containers": [{
          "name": "app", "image": "$image", "imagePullPolicy": "IfNotPresent",
          "ports": [{"name": "http", "containerPort": "$container_port"}],
          "resources": {"requests": {"cpu": "50m", "memory": "32Mi"}, "limits": {"cpu": "500m", "memory": "128Mi"}},
          "startupProbe": {"httpGet": {"path": "$health_path", "port": "http"}, "periodSeconds": 2, "failureThreshold": 30},
          "readinessProbe": {"httpGet": {"path": "$health_path", "port": "http"}, "periodSeconds": 3},
          "livenessProbe": {"httpGet": {"path": "$health_path", "port": "http"}, "periodSeconds": 10},
          "lifecycle": {"preStop": {"sleep": {"seconds": 5}}}
        }]
      }
    }
  }
}
